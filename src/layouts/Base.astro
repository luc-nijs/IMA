---
import '../styles/site.css';
import { nav, more } from '../data/nav.js';
import { url } from '../lib/url.js';

interface Props { title: string; description?: string; path: string; noindex?: boolean }
const { title, description = 'IMA conducts research on music education, music performance and musicology: embodied music pedagogy, musical creativity, music technology and well-being through music.', path, noindex = false } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(path === '/' ? '/' : `${path}/`, site).href : '';
const fullTitle = path === '/' ? 'IMA' : `${title} | IMA`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IMA" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {site && <meta property="og:image" content={new URL('/images/research.jpg', site).href} />}
    <meta name="theme-color" content="#1e3446" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,700;1,400&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Theme before the first paint, so there is no flash: a saved choice wins, otherwise the system's.
      (function () { var r = document.documentElement; r.classList.add('js'); try { var s = localStorage.getItem('ima-theme'); if (s) r.dataset.theme = s; } catch (e) {} })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url('/')}>
          <span><b>IMA</b></span>
        </a>
        <nav class="menu" id="menu" aria-label="Site">
          <ul>
            {nav.map((item) => <li><a href={url(item.href)} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a></li>)}
          </ul>
        </nav>
        <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
        <button class="icon-btn theme" type="button" aria-label="Switch between light and dark"><svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="top">
          <div>
            <h3>Explore</h3>
            <ul>{[...nav.slice(1), ...more].map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}</ul>
          </div>
        </div>
        <div class="bottom"><span>© {new Date().getFullYear()} IMA. All rights reserved.</span><a href="#main">To the top ↑</a></div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        document.querySelector('.theme').addEventListener('click', function () {
          var dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          root.dataset.theme = dark ? 'light' : 'dark';
          try { localStorage.setItem('ima-theme', root.dataset.theme); } catch (e) {}
        });
        var t = document.querySelector('.menu-toggle'), m = document.getElementById('menu');
        t.addEventListener('click', function () { var o = m.classList.toggle('open'); t.setAttribute('aria-expanded', o); });
        // Reveal blocks as they scroll in; count up numbers.
        if (!('IntersectionObserver' in window)) { document.querySelectorAll('.reveal').forEach(function (e) { e.classList.add('in'); }); return; }
        var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.classList.add('in'); io.unobserve(e.target);
            if (still) return;
            e.target.querySelectorAll('[data-count]').forEach(function (n) {
              var end = +n.dataset.count, suffix = n.dataset.suffix || '', start = end > 1000 ? end - 30 : 0, t0 = performance.now();
              (function tick(t) { var p = Math.min(1, (t - t0) / 1200); n.textContent = Math.round(start + (end - start) * (1 - Math.pow(1 - p, 3))) + (p === 1 ? suffix : ''); if (p < 1) requestAnimationFrame(tick); })(t0);
            });
          });
        }, { threshold: .15 });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
