---
import Base from '../layouts/Base.astro';
import '../styles/lists.css';
import { SHEET_CSV_URL, recordsFromCSV, prepare, listHtml, countText } from '../lib/lectures.js';
import snapshot from '../data/lectures-snapshot.json';

// Same system as the lucnijs.be agenda: written into the page at the build, refreshed in the browser
// from the IMA_lectures sheet. Without the sheet, the saved copy is used.
let source = snapshot;
if (SHEET_CSV_URL) {
  try {
    const res = await fetch(SHEET_CSV_URL, { signal: AbortSignal.timeout(20000) });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const fromSheet = recordsFromCSV(await res.text());
    if (!fromSheet.length) throw new Error('no usable rows');
    source = fromSheet;
  } catch (err) {
    console.warn('[lectures] Using the saved copy: the sheet could not be read.', err);
  }
}
const records = prepare(source);
const dataJson = JSON.stringify(records).replace(/</g, '\\u003c');
---
<Base title="Lectures" path="/lectures" description="Lectures, keynotes and workshops given by members of the Institute of Musicology and Arts, listed by year and shown on a map.">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
  </Fragment>
  <header class="page-head"><div class="wrap"><p class="eyebrow">Lectures</p><h1>Lectures &amp; <em>workshops</em></h1><p class="lead">Keynotes, invited lectures, conference talks and workshops by members of the Institute. Click an entry to find it on the map.</p></div></header>
  <section style="padding-top:40px">
    <div class="wrap">
      <div id="lecture-map-app">
        <div class="lm-controls">
          <span><label for="lm-kind">Type</label><select id="lm-kind"><option value="">all</option></select></span>
          <span><label for="lm-who">Speaker</label><select id="lm-who"><option value="">all</option></select></span>
          <span><label for="lm-from">From</label><select id="lm-from"></select> <label for="lm-to" style="margin-left:6px">to</label><select id="lm-to"></select></span>
          <span><input type="search" id="lm-q" placeholder="city, title…" size="18" aria-label="Search" /></span>
          <span class="lm-count" id="lm-count">{countText(records)}</span>
        </div>
        <div class="lm-split">
          <div id="lecture-map" role="region" aria-label="Map of lectures"></div>
          <div id="lm-list-pane"><div id="lm-list" set:html={listHtml(records, records)}></div></div>
        </div>
        <div class="lm-status" id="lm-status"></div>
      </div>
    </div>
  </section>
  <script id="lm-data" type="application/json" set:html={dataJson}></script>
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
</Base>

<script src="../lib/lectures-map.js"></script>
