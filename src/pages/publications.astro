---
import Base from '../layouts/Base.astro';
import '../styles/lists.css';
import { SHEET_CSV_URL, recordsFromCSV, listHtml, countText } from '../lib/publications.js';
import snapshot from '../data/publications-snapshot.json';

// Same system as lucnijs.be: the list is written into the page at the build (for search engines),
// then the browser refreshes it from the IMA_publications sheet. Without the sheet, the saved copy is used.
let records = snapshot;
if (SHEET_CSV_URL) {
  try {
    const res = await fetch(SHEET_CSV_URL, { signal: AbortSignal.timeout(20000) });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const fromSheet = recordsFromCSV(await res.text());
    if (!fromSheet.length) throw new Error('no usable rows');
    records = fromSheet;
  } catch (err) {
    console.warn('[publications] Using the saved copy: the sheet could not be read.', err);
  }
}
const dataJson = JSON.stringify(records).replace(/</g, '\\u003c');
---
<Base title="Publications" path="/publications" description="Publications of the Institute of Musicology and Arts at the University of Luxembourg: journal articles, books and chapters on music education and performance.">
  <header class="page-head"><div class="wrap"><p class="eyebrow">Publications</p><h1>Publi&shy;cations</h1><p class="lead">Journal articles, books and chapters by the members of the Institute.</p></div></header>
  <section style="padding-top:50px">
    <div class="wrap">
      <div class="pb-app" id="pub-app">
        <div class="pb-controls">
          <span><label for="pb-group">Group by</label><select id="pb-group"><option value="year">year</option><option value="type">type</option></select></span>
          <span><label for="pb-type">Type</label><select id="pb-type"><option value="">all</option></select></span>
          <span><label for="pb-from">From</label><select id="pb-from"></select> <label for="pb-to" style="margin-left:6px">to</label><select id="pb-to"></select></span>
          <span><input type="search" id="pb-q" placeholder="author, title, journal…" size="22" aria-label="Search" /></span>
          <span class="pb-count" id="pb-count">{countText(records)}</span>
        </div>
        <div id="pb-list" set:html={listHtml(records, 'year')}></div>
        <div class="pb-status" id="pb-status"></div>
      </div>
    </div>
  </section>
  <script id="pb-data" type="application/json" set:html={dataJson}></script>
</Base>

<script>
  import { SHEET_CSV_URL, TYPE_ORDER, TYPE_LABEL, esc, listHtml, countText, recordsFromCSV } from '../lib/publications.js';
  const $ = (id: string) => document.getElementById(id) as any;
  let records: any[] = [];

  function applyFilters() {
    const type = $('pb-type').value, from = Number($('pb-from').value), to = Number($('pb-to').value);
    const q = $('pb-q').value.trim().toLowerCase();
    const hit = records.filter((r) => {
      if (type && r.type !== type) return false;
      const y = Number(r.year);
      if (y && (y < from || y > to)) return false;   // undated and forthcoming items always show
      if (q && !r._hay.includes(q)) return false;
      return true;
    });
    $('pb-count').textContent = countText(hit);
    $('pb-list').innerHTML = listHtml(hit, $('pb-group').value);
  }
  function addOptions(id: string, values: any[], labels: any) {
    for (const v of values) $(id).insertAdjacentHTML('beforeend', '<option value="' + esc(v) + '">' + esc(labels[v] || v) + '</option>');
  }
  function start(list: any[], note: string) {
    records = list.map((r) => ({ ...r, _hay: [r.authors, r.title, r.venue, r.type, r.status, r.year, r.language, r.doi].filter(Boolean).join(' ').toLowerCase() }));
    const rank = (a: string, b: string) => (TYPE_ORDER.indexOf(a) + 1 || 99) - (TYPE_ORDER.indexOf(b) + 1 || 99);
    addOptions('pb-type', [...new Set(records.map((r) => r.type).filter(Boolean))].sort(rank), TYPE_LABEL);
    const years = records.map((r) => Number(r.year)).filter((y) => y > 1900);
    const lo = Math.min(...years), hi = Math.max(...years);
    for (let y = hi; y >= lo; y--) { addOptions('pb-from', [y], {}); addOptions('pb-to', [y], {}); }
    $('pb-from').value = lo; $('pb-to').value = hi;
    for (const id of ['pb-group', 'pb-type', 'pb-from', 'pb-to']) $(id).addEventListener('change', applyFilters);
    $('pb-q').addEventListener('input', applyFilters);
    applyFilters();
    $('pb-status').textContent = note;
  }
  const saved = () => JSON.parse($('pb-data').textContent);
  if (!SHEET_CSV_URL) start(saved(), 'Use the filters above, or search by author, title or journal.');
  else fetch(SHEET_CSV_URL + '&v=' + Math.floor(Date.now() / 60000), { cache: 'no-cache' })
    .then((res) => { if (!res.ok) throw new Error('HTTP ' + res.status); return res.text(); })
    .then((text) => { const l = recordsFromCSV(text); if (!l.length) throw new Error('no rows'); start(l, 'Use the filters above, or search by author, title or journal.'); })
    .catch(() => start(saved(), 'Showing the saved list: the live sheet could not be read.'));
</script>
