---
import Base from '../layouts/Base.astro';
// As on the other sites: the form opens the visitor's own email program. Nothing is stored anywhere.
const TO = 'luc.nijs@uni.lu';
---
<Base title="Contact" path="/contact" description="Contact the Institute of Musicology and Arts at the University of Luxembourg.">
  <header class="page-head"><div class="wrap"><p class="eyebrow">Contact</p><h1>Get in <em>touch</em></h1><p class="lead">Questions about our research, a collaboration or a doctoral project? Write to us.</p></div></header>
  <section>
    <div class="wrap">
      <form class="contact-form" id="contact-form" data-to={TO}>
        <div class="two">
          <div><label for="first">First name *</label><input id="first" name="first" required autocomplete="given-name" /></div>
          <div><label for="last">Last name</label><input id="last" name="last" autocomplete="family-name" /></div>
        </div>
        <label for="aff">Affiliation</label><input id="aff" name="aff" autocomplete="organization" />
        <label for="email">Email *</label><input id="email" name="email" type="email" required autocomplete="email" />
        <label for="msg">Message</label><textarea id="msg" name="msg"></textarea>
        <button class="btn" type="submit">Send <span>→</span></button>
        <p class="note">Sending opens your own email program with the message filled in.</p>
      </form>
    </div>
  </section>
  <script is:inline>
    document.getElementById('contact-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var f = e.target, v = function (n) { return f.elements[n].value.trim(); };
      var name = (v('first') + ' ' + v('last')).trim();
      var body = v('msg') + '\n\n' + name + (v('aff') ? '\n' + v('aff') : '') + '\n' + v('email');
      location.href = 'mailto:' + f.dataset.to + '?subject=' + encodeURIComponent('via website') + '&body=' + encodeURIComponent(body);
    });
  </script>
</Base>
